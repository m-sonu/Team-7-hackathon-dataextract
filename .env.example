# Ollama Settings (used when AI_PROVIDER=ollama)
# AI_PROVIDER=ollama
# OLLAMA_API_URL=http://localhost:11434/api/chat
# AI_MODEL=qwen2.5-coder:14b

# Bedrock Settings (used when AI_PROVIDER=bedrock)
AI_PROVIDER=bedrock
BEDROCK_MODEL=
AWS_REGION=

# AWS credentials — set these when running outside EC2/ECS.
# On EC2 or ECS with an IAM role attached, leave these blank; boto3 picks up
# credentials automatically from the instance metadata service.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
